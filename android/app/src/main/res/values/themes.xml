<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Apteka360" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Apteka360.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1B8A55</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Apteka360</item>
    </style>
</resources>
