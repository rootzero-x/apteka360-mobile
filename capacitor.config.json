{
  "appId": "uz.apteka360.app",
  "appName": "Apteka 360",
  "webDir": "www",
  "server": {
    "url": "https://apteka.agrom24.uz",
    "errorPath": "error.html",
    "cleartext": false
  },
  "android": {
    "appendUserAgent": "Apteka360Mobile/1.0.0 (android)",
    "allowMixedContent": false,
    "backgroundColor": "#0f766e",
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0f766e",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
